# Dependencies and build output. The app now lives at the repository root rather than under
# `web/`, so these are unanchored -- `tools/measure-browser` has its own `node_modules` too.
node_modules/
dist/
*.tsbuildinfo

# Rayfin's local scratch: the compiled schema and the deploy lockfile are regenerated by the CLI
# from `rayfin/data` on every `rayfin up`, so committing them only produces conflicts.
rayfin/.temp/
rayfin/.lockfile.json

# Vite reads these at build time and they carry tenant identifiers and a publishable key.
.env
.env.*
!.env.example

.vscode/
.idea/
*.user
*.suo
*.log

# Local cache written by the impeccable design-review tooling. It records
# per-file hook state for this checkout only and carries no project meaning.
.impeccable/
