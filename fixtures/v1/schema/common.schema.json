{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlsimcity.example/fixtures/v1/schema/common.schema.json",
  "title": "SQLSimCity telemetry fixture common types",
  "$defs": {
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "unsupported",
        "not-probed",
        "permission-denied",
        "disconnected",
        "disappeared",
        "unavailable"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "probable",
        "unknown"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ]
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO 8601 observation or source timestamp."
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Exact byte count; null means unavailable, not zero."
    },
    "pages": {
      "type": "integer",
      "minimum": 0,
      "description": "Exact 8 KiB page count when supplied."
    },
    "microseconds": {
      "type": "number",
      "minimum": 0,
      "description": "Duration in microseconds."
    },
    "milliseconds": {
      "type": "number",
      "minimum": 0,
      "description": "Duration in milliseconds."
    },
    "compoundId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[^|]+)?(?:\\|[a-z][a-z0-9-]*:[^|]+)*$",
      "description": "Stable identity composed from named, delimiter-separated dimensions."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The DMV, catalog view, cache, or synthetic evidence source that produced this value."
    },
    "availabilityReason": {
      "type": "string",
      "minLength": 1,
      "description": "Required when availability cannot be used as ordinary observed data."
    }
  }
}
