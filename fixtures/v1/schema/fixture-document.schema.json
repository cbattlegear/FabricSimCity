{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlsimcity.example/fixtures/v1/schema/fixture-document.schema.json",
  "title": "SQLSimCity telemetry fixture document envelope",
  "type": "object",
  "required": [
    "fixtureVersion",
    "fixtureId"
  ],
  "properties": {
    "fixtureVersion": {
      "const": "1.0.0",
      "description": "Pack semantic version. A breaking fixture contract gets a new major directory."
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$",
      "description": "Stable fixture document identity."
    },
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp"
    }
  },
  "additionalProperties": true
}
